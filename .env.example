# Copy to .env and adjust. All paths are machine-specific; nothing is hard-coded.
SOURCE_ROOT=/path/to/your/java/repository
DATA_ROOT=./data
# CHROMA_PATH defaults to $DATA_ROOT/indexes/chroma when empty
CHROMA_PATH=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
LOG_LEVEL=INFO
MAX_CONTEXT_TOKENS=8000
MAX_SOURCE_FILES=20000
MAX_CALL_DEPTH=2
ENABLE_GIT_ANALYSIS=false
ENABLE_TEST_ANALYSIS=true
# Comma-separated directory names skipped during scanning
IGNORE_DIRS=target,build,.git,node_modules,generated,out,.idea,.gradle
MAX_FILE_BYTES=2000000

# Java analyzer sidecar (JavaParser). Needs a JDK 17+ runtime.
# Machine-specific: point JAVA_BIN at your JDK, e.g. /opt/homebrew/opt/openjdk@17/bin/java
JAVA_BIN=java
# Defaults to java-analyzer/target/java-analyzer.jar (build with `make analyzer`)
#ANALYZER_JAR=
ANALYZER_TIMEOUT_SECONDS=300
